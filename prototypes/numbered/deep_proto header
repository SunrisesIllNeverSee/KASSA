<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KA§§A · Light Lab Gradient</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-main: #FFFFFF;
            --bg-subtle: #F8FAFC;
            --bg-card: #FFFFFF;
            --accent-primary: #00BFA5;   
            --accent-secondary: #E91E63;  
            --accent-tertiary: #4F46E5;   
            --text-primary: #0F172A;
            --text-muted: #64748B;
            --border-strong: #0F172A;
            --border-light: #E2E8F0;
            /* Modern Grid Texture */
            --grid-line: rgba(15, 23, 42, 0.04);
            --grid-pattern: radial-gradient(circle, var(--grid-line) 1px, transparent 1px);
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 0 48px;
        }

        section {
            padding: 100px 0;
            border-bottom: 1px solid var(--border-light);
        }

        /* Typography with Gradients */
        h1, h2, h3 {
            font-weight: 800;
            letter-spacing: -0.04em;
            color: var(--text-primary);
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent-primary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
        }

        h1 {
            font-size: 76px;
            line-height: 0.95;
            margin-bottom: 24px;
        }

        h2 {
            font-size: 52px;
            margin-bottom: 24px;
        }

        .section-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: var(--accent-tertiary);
            margin-bottom: 16px;
            display: block;
            font-weight: 700;
        }

        .body-text {
            color: var(--text-muted);
            font-size: 18px;
            max-width: 600px;
        }

        /* Buttons */
        .btn-primary {
            display: inline-block;
            background: var(--text-primary);
            color: #FFF;
            font-weight: 700;
            padding: 18px 44px;
            border-radius: 6px;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--text-primary);
            font-size: 16px;
        }

        .btn-primary:hover {
            background: var(--accent-primary);
            border-color: var(--accent-primary);
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 191, 165, 0.2);
        }

        .btn-secondary {
            display: inline-block;
            background: transparent;
            color: var(--text-primary);
            border: 1.5px solid var(--border-strong);
            padding: 18px 44px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 700;
            transition: 0.2s;
            font-size: 16px;
        }

        .btn-secondary:hover {
            background: var(--bg-subtle);
            border-color: var(--accent-tertiary);
            color: var(--accent-tertiary);
        }

        /* Navigation */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 48px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-light);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-family: 'JetBrains Mono', monospace;
            font-size: 26px;
            font-weight: 800;
            color: var(--text-primary);
            text-decoration: none;
            letter-spacing: -1px;
        }

        .logo span { color: var(--accent-primary); }

        .nav-links { display: flex; gap: 40px; align-items: center; }
        .nav-links a {
            color: var(--text-primary);
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: color 0.2s;
        }
        .nav-links a:hover { color: var(--accent-primary); }

        /* Hero */
        .hero-layout {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 80px;
            align-items: center;
        }

        .hero-visual {
            background-color: var(--bg-subtle);
            background-image: var(--grid-pattern);
            background-size: 30px 30px;
            border: 1px solid var(--border-light);
            height: 500px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: inset 0 0 40px rgba(0,0,0,0.02);
        }

        .hero-visual::after {
            content: "§";
            font-size: 240px;
            color: var(--text-primary);
            opacity: 0.05;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 800;
        }

        /* Tech Cards */
        .tech-card {
            border: 1px solid var(--border-light);
            padding: 48px;
            border-radius: 20px;
            background: var(--bg-card);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .tech-card:hover {
            border-color: var(--accent-primary);
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.05);
        }

        .badge {
            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
            background: var(--bg-subtle);
            padding: 6px 14px;
            border-radius: 20px;
            color: var(--accent-tertiary);
            margin-bottom: 24px;
            display: inline-block;
            border: 1px solid var(--border-light);
            font-weight: 700;
        }

        /* Listing Box */
        .listing-box {
            display: grid;
            grid-template-columns: 1fr 420px;
            border: 1.5px solid var(--border-strong);
            border-radius: 24px;
            overflow: hidden;
            margin-top: 40px;
            box-shadow: 0 30px 60px rgba(15, 23, 42, 0.1);
        }

        .listing-main {
            padding: 70px;
            background: #FFF;
        }

        .listing-sidebar {
            padding: 70px;
            background: var(--text-primary);
            color: #FFF;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            padding: 16px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            font-family: 'JetBrains Mono', monospace;
            font-size: 15px;
        }

        .progress-container {
            height: 6px;
            background: rgba(255,255,255,0.1);
            margin: 24px 0;
            border-radius: 3px;
        }

        .progress-bar {
            height: 100%;
            background: var(--accent-primary);
            width: 65%;
            border-radius: 3px;
            box-shadow: 0 0 15px var(--accent-primary);
        }

        /* Moat Section */
        .moat-container {
            background-color: var(--bg-subtle);
            background-image: var(--grid-pattern);
            background-size: 40px 40px;
            border: 1px solid var(--border-light);
            border-radius: 32px;
            padding: 100px 40px;
            text-align: center;
        }

        .footer {
            background: #FFF;
            padding: 100px 48px;
            border-top: 1px solid var(--border-light);
        }

        @media (max-width: 1100px) {
            .hero-layout, .listing-box { grid-template-columns: 1fr; }
            h1 { font-size: 56px; }
            .container { padding: 0 24px; }
            .listing-sidebar { padding: 40px; }
        }
    </style>
</head>
<body>
